{
  "name": "bizcomms-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:db": "supabase test db",
    "test:pgtap": "pg_prove -U postgres -d \"$DATABASE_URL\" tests/rls.test.sql",
    "supabase:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "typecheck": "tsc --noEmit",
    "test:rls": "node tests/rls.test.mjs",
    "test:unit": "sucrase-node tests/telephony.test.ts && sucrase-node tests/replay.test.ts && sucrase-node tests/sms.test.ts && sucrase-node tests/dashboard.test.ts && sucrase-node tests/billing.test.ts && sucrase-node tests/release.test.ts && sucrase-node tests/voice.test.ts",
    "simulate": "sucrase-node scripts/simulate.ts",
    "verify": "npm run typecheck && npm run test:unit && npm run test:rls && npm run simulate",
    "db:migrate": "node scripts/supabase-migrate.mjs",
    "test:e2e": "sucrase-node tests/e2e/module-a.e2e.ts --i-understand-this-writes-to-supabase && sucrase-node tests/e2e/module-b.e2e.ts --i-understand-this-writes-to-supabase"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.6",
    "@tanstack/react-query": "^5.59.15",
    "@upstash/ratelimit": "^2.0.4",
    "@upstash/redis": "^1.34.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "google-auth-library": "^9.15.0",
    "libphonenumber-js": "^1.11.12",
    "lucide-react": "^0.453.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.4",
    "openai": "^7.39.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.1",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "sonner": "^1.5.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^6.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.13.0",
    "eslint-config-next": "^16.4.2",
    "pg": "^8.23.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3"
  }
}
