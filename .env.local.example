# ==============================================================================
# B2B LOCAL BUSINESS COMMUNICATIONS OS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY NOTICE:
# Variables marked [CRITICAL SECRET] must NEVER be prefixed with NEXT_PUBLIC_.
# Exposing them to the browser compromises tenant isolation, API billing, and data.
# SUPABASE_SERVICE_ROLE_KEY may ONLY be imported in `src/lib/supabase/admin.ts`
# which is protected with `import 'server-only'`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & PUBLIC HOSTING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="LocalComms OS"

# EMERGENCY PLATFORM KILL-SWITCH (Instantly disables all outbound telephony & AI calls)
EMERGENCY_KILL_SWITCH="false"

# ------------------------------------------------------------------------------
# 2. $0 DEV & ZERO-COST MOCK FLAGS (Run 100% of the stack locally with no accounts)
# ------------------------------------------------------------------------------
USE_MOCK_TELEPHONY="true"       # When true, mocks Twilio TwiML and inbound call simulation
USE_MOCK_SMS="true"             # When true, logs SMS to console/DB without dispatching to Twilio
USE_MOCK_VOICE_AI="true"        # When true, simulates Vapi SIP connection & end-of-call webhooks
USE_MOCK_GOOGLE_REVIEWS="true"  # When true, generates synthetic Google reviews & mock publishes
USE_MOCK_BILLING="true"         # When true, simulates Stripe subscriptions & usage tiers

# LLM PROVIDER FOR REVIEW REPLIES: "mock" | "openai" | "gemini" | "groq" | "ollama"
LLM_PROVIDER="mock"

# RATE LIMIT PROVIDER: "memory" (free local/dev) | "postgres" (free serverless) | "upstash" (redis)
RATE_LIMIT_PROVIDER="memory"

# ------------------------------------------------------------------------------
# 3. SUPABASE (Database, Auth & Storage)
# ------------------------------------------------------------------------------
# Local Supabase CLI defaults (run `supabase start` in terminal)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.local-anon-key"

# [CRITICAL SECRET] - Full DB administrative privileges. Bypasses RLS.
# Strictly imported via `src/lib/supabase/admin.ts` with `import 'server-only'`.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.local-service-role-key"

# [CRITICAL SECRET] Direct Postgres URI, used only by `npm run db:migrate` (never by the app).
# Supabase: Project Settings -> Database -> Connection string -> URI (session pooler).
DATABASE_URL=""

# [CRITICAL SECRET] - 32-byte Base64 key for encrypting Google OAuth tokens at rest in `google_tokens`
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="your-32-byte-base64-encryption-key-here="

# ------------------------------------------------------------------------------
# 4. TELEPHONY & MESSAGING (Twilio - Live Credentials when USE_MOCK_* is false)
# ------------------------------------------------------------------------------
# [CRITICAL SECRET]
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# [CRITICAL SECRET]
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
# Pre-registered A2P 10DLC Messaging Service SID for carrier compliance
TWILIO_MESSAGING_SERVICE_SID="MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# Fallback platform number (E.164 format)
TWILIO_DEFAULT_PHONE_NUMBER="+12025550199"
# Public URL used for Twilio Webhook signature validation (e.g. https://xyz.ngrok-free.app in dev)
TWILIO_WEBHOOK_BASE_URL="http://localhost:3000"
# Who answers STOP / START / HELP keywords:
#   "twilio" (default) - Twilio Opt-Out Management (set custom replies on the Messaging Service);
#                        the app records opt-out state and only confirms plain-language opt-outs.
#   "app"              - Twilio keyword handling is turned OFF and this app sends every reply.
# Never run both, or customers get duplicate confirmations.
SMS_KEYWORD_REPLIES="twilio"
# Edge fail-open worker (DESIGN_NOTES §6). When both are set, every provisioned number gets a
# VoiceFallbackUrl of FAIL_OPEN_WORKER_URL?to=<forward number>&sig=<HMAC-SHA256(to, secret)>.
# [CRITICAL SECRET] FALLBACK_SIGNING_SECRET must match the worker's secret.
FAIL_OPEN_WORKER_URL=""
FALLBACK_SIGNING_SECRET=""

# ------------------------------------------------------------------------------
# 5. VOICE AI (Vapi.ai / Retell AI - Live Credentials when USE_MOCK_VOICE_AI is false)
# ------------------------------------------------------------------------------
# [CRITICAL SECRET]
VAPI_API_KEY="vapi_live_your_private_api_key_here"
# [CRITICAL SECRET] - Secret header token to verify authenticity of Vapi end-of-call webhooks
VAPI_WEBHOOK_SECRET="vapi_whsec_your_custom_secret_token"
# Vapi SIP host (US). Each business gets its own Vapi SIP number at
# sip:bizcomms-<organization id>@<host>, created when they turn on the AI receptionist.
VAPI_SIP_ENDPOINT="sip.vapi.ai"
# Optional platform-level Vapi SIP number (sip:<user>@sip.vapi.ai) dialed only when the
# database is unreachable, so missed callers still reach an AI instead of a hang-up.
VAPI_DEFAULT_SIP_URI=""
# Preferred webhook auth: a Vapi Custom Credential (Bearer = VAPI_WEBHOOK_SECRET) referenced by id.
# If empty, assistants send VAPI_WEBHOOK_SECRET in the legacy X-Vapi-Secret header instead.
VAPI_WEBHOOK_CREDENTIAL_ID=""

# Optional alternative Voice AI Provider
# RETELL_API_KEY="key_your_retell_api_key_here"

# ------------------------------------------------------------------------------
# 6. LLM PROVIDERS FOR REVIEW REPLIES
# ------------------------------------------------------------------------------
# Option A: OpenAI (Paid)
# [CRITICAL SECRET]
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Option B: Google Gemini API (Free tier: 15 RPM / 1M TPM / 1500 RPD)
# [CRITICAL SECRET]
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
# Must be "true" to use Gemini at all: only a billing-enabled (paid) project is allowed, because the
# free tier may use prompts (customer reviews) for training.
GEMINI_PAID_TIER_CONFIRMED="false"

# Option C: Groq (Free tier: fast inference for open weights)
# [CRITICAL SECRET]
GROQ_API_KEY="gsk_your-groq-api-key-here"
GROQ_MODEL="llama-3.1-8b-instant"

# Option D: Local Ollama (100% Free, offline local inference)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# ------------------------------------------------------------------------------
# 7. GOOGLE BUSINESS PROFILE (Reviews & OAuth2)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
# [CRITICAL SECRET]
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 8. STRIPE (SaaS Subscriptions & Metered Usage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"
# [CRITICAL SECRET]
STRIPE_SECRET_KEY="sk_test_your_key_here"
# [CRITICAL SECRET]
STRIPE_WEBHOOK_SECRET="whsec_your_secret_here"
STRIPE_PRICE_STARTER="price_starter_id"
STRIPE_PRICE_GROWTH="price_growth_id"
# Optional free trial (days) on the Missed-Call Text-Back plan; card is still collected at checkout.
STRIPE_TRIAL_DAYS="14"
# Stripe webhook endpoint: https://<your domain>/api/stripe/webhook
#   events: checkout.session.completed, customer.subscription.created/updated/deleted/paused/resumed

# ------------------------------------------------------------------------------
# 9. RATE LIMITING CACHE (Upstash Redis - optional if RATE_LIMIT_PROVIDER="memory")
# ------------------------------------------------------------------------------
# [CRITICAL SECRET]
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
# [CRITICAL SECRET]
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# [CRITICAL SECRET] - Bearer token for triggering cron endpoints (/api/cron/*)
CRON_SECRET="your_custom_secure_cron_secret_token_here"
# Days after a subscription is canceled/unpaid before its Twilio number is released by
# /api/cron/release-lapsed-numbers (run daily). Default 30; values below 7 are raised to 7.
NUMBER_RELEASE_GRACE_DAYS="30"

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY (Optional)
# ------------------------------------------------------------------------------
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"
